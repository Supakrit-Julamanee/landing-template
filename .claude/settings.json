{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(git init*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(vercel --prod*)",
      "Bash(npx vercel --prod*)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
